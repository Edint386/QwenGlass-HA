# Network: keep the Python service on loopback. Caddy is the only public entry.
BIND_HOST=127.0.0.1
BIND_PORT=8000
ALLOWED_HOSTS=ha.qwen.xsnight.cn,localhost,127.0.0.1

# Home Assistant credentials are file-backed and must be mode 0600.
HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN_FILE=/opt/qwen-bridge/secrets/ha_token
HA_TIMEOUT_SECONDS=3
HA_KEEPALIVE_INTERVAL_SECONDS=10

# Bridge authentication is required by default. Configure the matching
# Authorization: Bearer <value> header in the Qwen custom MCP service.
BRIDGE_AUTH_MODE=required
BRIDGE_API_KEY_FILE=/opt/qwen-bridge/secrets/bridge_api_key

# Fail-closed write policy. Keep false until authentication works end-to-end.
ENABLE_WRITE_TOOLS=false
# Both lists are mandatory when writes are enabled. Services define which
# actions exist; entities define the only devices those actions may target.
ALLOWED_HA_SERVICES=climate.turn_on,climate.turn_off,climate.set_temperature,light.turn_on,light.turn_off
ALLOWED_HA_ENTITIES=climate.living_room,light.desk
# Aliases are embedded into the existing call_ha_service tool description, so
# common phrases work without another MCP interface or a published Skill.
HA_DEVICE_ALIASES_JSON='{"空调":"climate.living_room","客厅空调":"climate.living_room","挂灯":"light.desk"}'
CLIMATE_TEMPERATURE_MIN=16
CLIMATE_TEMPERATURE_MAX=30

# Qwen compatibility: permits calls when its execution client skips the
# initialized notification or session header. No authorization state is kept
# in an MCP session, so this does not bypass bridge authentication.
MCP_RELAXED_SESSIONS=true

REQUEST_BODY_LIMIT=65536
MAX_HA_RESPONSE_BYTES=5000000
MAX_SERVICE_DATA_BYTES=16384
MAX_STATE_RESULTS=1000
MAX_CONCURRENT_HA_REQUESTS=8
SESSION_TTL_SECONDS=900
MAX_SESSIONS=1024
LOG_LEVEL=INFO
