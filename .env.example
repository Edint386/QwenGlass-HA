# 复制成仓库根目录的 .env，deploy/compose.yaml 读它。权限设成 600。

# 平台 MCP 插件填的 Bearer Token：自己生成一串随机字符，比如 openssl rand -hex 24
GLASSHOME_MCP_TOKEN=

# Home Assistant 的长期访问令牌：HA 网页左下角点用户名 → 安全 → 长期访问令牌 → 创建令牌
GLASSHOME_HA_TOKEN=

# HA 的 WebSocket 地址。用 compose 里自带的 HA 就不用改
GLASSHOME_HA_URL=ws://homeassistant:8123/api/websocket

# 老的 Agent 接入（只认固定说法、不过大模型）用的 Token。部署指南不用它，留空就不开 /agent
GLASSHOME_AGENT_TOKEN=
